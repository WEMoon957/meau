# API Key（通义千问 DashScope）
OPENAI_API_KEY=your-api-key-here

# API 基础地址（通义千问 DashScope OpenAI兼容接口）
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 模型名称（通义千问，前缀为 qwen- 不是 qianwen-）
OPENAI_MODEL=qwen-turbo

# MySQL 数据库配置
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=restaurant

# 是否启用数据库模式（true=从数据库读取, false=使用本地硬编码数据）
USE_DATABASE=true

# 会话与并发控制
SESSION_TTL_SECONDS=1800          # 会话无活动过期时间（秒），默认 30 分钟
SESSION_CLEANUP_INTERVAL=300      # 后台清理间隔（秒），默认 5 分钟
MAX_SESSIONS=500                    # 最大同时存活会话数
MAX_CONCURRENT_CHATS=20             # 最大同时 LLM 对话数，超出返回 503

# API 限流（固定窗口，O(1) 内存检查）
CHAT_RATE_PER_SESSION=30            # 每会话每窗口最大 chat 次数
CHAT_RATE_PER_IP=60                 # 每 IP 每窗口最大 chat 次数
CHAT_RATE_WINDOW=60                 # 限流窗口（秒）
