# API Key（通义千问 DashScope）
OPENAI_API_KEY=your-api-key-here

# API 基础地址（通义千问 DashScope OpenAI兼容接口）
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 模型名称（通义千问，前缀为 qwen- 不是 qianwen-）
OPENAI_MODEL=qwen-max

# 向量模型（text-embedding-v3 支持 1024 维，与 config.py 中 EMBEDDING_DIMENSIONS=1024 匹配）
EMBEDDING_MODEL=text-embedding-v3

# MySQL 数据库配置
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=restaurant

# 是否启用数据库模式（true=从数据库读取, false=使用本地硬编码数据）
USE_DATABASE=true

# ===== 高并发配置 =====
# Redis 连接（多 worker 模式【必须】配置，未配置则回退单 worker 内存模式）
# 多 worker 下若缺失此项，会话与限流将退化为进程内，导致串号与限流失效。
REDIS_URL=redis://127.0.0.1:6379/0

# gunicorn worker 数（推荐 CPU核心数×2+1，需保证 DB_POOL_SIZE×WORKERS <= MySQL max_connections×0.8）
WORKERS=4

# 单 worker 并发 LLM 调用上限（信号量背压，超限立即 503）
MAX_CONCURRENT_CHATS=20

# LLM 单次请求超时（秒，超时抛 503，防慢请求堆积）
LLM_REQUEST_TIMEOUT=30

# MySQL 连接池（单 worker 持有，多 worker 各自独立池）
DB_POOL_SIZE=20
DB_POOL_MIN_CACHED=2
DB_POOL_MAX_CACHED=5
DB_CONN_RECYCLE=1800
# 查询最大执行时间（毫秒，注入 MAX_EXECUTION_TIME 优化器提示，硬约束）
DB_MAX_EXECUTION_MS=5000
DB_DISH_LIMIT=1000

# 会话与并发控制
SESSION_TTL_SECONDS=1800
SESSION_CLEANUP_INTERVAL=300
MAX_SESSIONS=500

# API 限流（固定窗口，Redis 模式下多 worker 共享计数）
CHAT_RATE_PER_SESSION=30
CHAT_RATE_PER_IP=60
CHAT_RATE_WINDOW=60

# 购物车限流（阈值更严：上游收钱吧网关有调用成本，防刷爆）
CART_RATE_PER_SESSION=10
CART_RATE_PER_IP=20
CART_RATE_WINDOW=60

# 会话管理操作限流（reset 等对象级操作）
SESSION_OPS_RATE_PER_SESSION=10
SESSION_OPS_RATE_WINDOW=60

# CORS 跨域来源（生产环境必须显式配置，逗号分隔）
CORS_ALLOWED_ORIGINS=https://order.example.com,https://www.example.com

# 可信反向代理 CIDR（逗号分隔，未配置时忽略 X-Forwarded-For）
TRUSTED_PROXIES=127.0.0.1/32

# 日志级别
LOG_LEVEL=INFO
